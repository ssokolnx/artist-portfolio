# Скопируйте этот файл в .env для локального запуска и заполните значения.
# На Render эти же переменные задаются в разделе Environment.

# Пароль для входа в админку
ADMIN_PASSWORD=

# Случайная строка для защиты сессий (любой длинный набор символов)
SESSION_SECRET=

# Данные репозитория GitHub, где хранится содержимое сайта (тексты и фото)
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# Личный токен доступа GitHub (создаётся в настройках GitHub, права: repo)
GITHUB_TOKEN=

PORT=3000
