<!DOCTYPE html>
<html lang="ru">
<head>
  <title>Галерея — <%= siteTitle %></title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="wrap page">
    <p class="eyebrow">Собрание работ</p>
    <h1 class="page-title">Галерея</h1>

    <% if (items.length === 0) { %>
      <p class="empty-state">Картины пока не добавлены.</p>
    <% } else { %>
      <div class="gallery-grid">
        <% items.forEach(function(item, idx) { %>
          <a
            href="/gallery/<%= item.id %>"
            class="artwork reveal"
            style="transition-delay: <%= Math.min(idx * 50, 400) %>ms"
            data-modal-card
            data-image="<%= item.imageFull ? rawUrl(item.imageFull) : (item.imageThumb ? rawUrl(item.imageThumb) : '') %>"
            data-title="<%= item.title %>"
            data-year="<%= item.year || '' %>"
            data-event="<%= item.event || '' %>"
            data-description="<%= item.description || '' %>"
          >
            <div class="artwork__frame">
              <% if (item.imageThumb) { %>
                <img src="<%= rawUrl(item.imageThumb) %>" alt="<%= item.title %>" loading="lazy" />
              <% } %>
            </div>
            <div class="artwork__label">
              <span class="artwork__title"><%= item.title %></span><% if (item.year) { %>, <span class="artwork__year"><%= item.year %></span><% } %>
              <% if (item.event) { %><p class="artwork__event"><%= item.event %></p><% } %>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </main>

  <%- include('partials/modal') %>
  <%- include('partials/footer') %>
  <script src="/js/modal.js"></script>
</body>
</html>
