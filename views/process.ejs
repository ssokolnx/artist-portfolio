<!DOCTYPE html>
<html lang="ru">
<head>
  <title>Рукоделие — <%= siteTitle %></title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="wrap page">
    <p class="eyebrow">За кулисами</p>
    <h1 class="page-title">Рукоделие</h1>

    <% if (items.length === 0) { %>
      <p class="empty-state">Фотографии пока не добавлены.</p>
    <% } else { %>
      <div class="gallery-grid">
        <% items.forEach(function(item, idx) { %>
          <button
            type="button"
            class="artwork reveal"
            style="transition-delay: <%= Math.min(idx * 50, 400) %>ms"
            data-modal-card
            data-image="<%= item.imageFull ? rawUrl(item.imageFull) : (item.imageThumb ? rawUrl(item.imageThumb) : '') %>"
            data-title="<%= item.title %>"
          >
            <div class="artwork__frame">
              <% if (item.imageThumb) { %>
                <img src="<%= rawUrl(item.imageThumb) %>" alt="<%= item.title %>" loading="lazy" />
              <% } %>
            </div>
            <% if (item.title) { %>
              <div class="artwork__label">
                <span class="artwork__title"><%= item.title %></span>
              </div>
            <% } %>
          </button>
        <% }); %>
      </div>
    <% } %>
  </main>

  <%- include('partials/modal') %>
  <%- include('partials/footer') %>
  <script src="/js/modal.js"></script>
</body>
</html>
