<!DOCTYPE html>
<html lang="ru">
<head>
  <title><%= siteTitle %></title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="hero wrap">
    <div class="hero__grid">
      <div class="hero__photo">
        <% if (home.photo) { %>
          <img src="<%= rawUrl(home.photo) %>" alt="<%= home.title %>" />
        <% } else { %>
          <div class="hero__photo-placeholder">Фото появится здесь</div>
        <% } %>
      </div>
      <div class="hero__text">
        <p class="eyebrow">Художница</p>
        <h1><%= home.title %></h1>
        <p class="hero__greeting"><%= home.greeting %></p>
        <a class="button button--outline" href="/gallery">Смотреть галерею</a>
      </div>
    </div>
  </main>

  <% if (featured && featured.length > 0) { %>
    <section class="featured">
      <div class="wrap featured__head">
        <h2 class="featured__heading">Работы</h2>
        <a href="/gallery" class="featured__all">Вся галерея →</a>
      </div>

      <div class="carousel">
        <div class="carousel__track">
          <% // Список отрисован в три набора подряд. Лента стартует с середины —
             // так остаётся запас, чтобы крутить и вперёд, и назад, и в обе
             // стороны кажется, что она никогда не кончается. %>
          <% [...featured, ...featured, ...featured].forEach(function(item, idx) { %>
            <a
              href="/gallery/<%= item.id %>"
              class="artwork carousel__item"
              data-modal-card
              data-image="<%= item.imageFull ? rawUrl(item.imageFull) : (item.imageThumb ? rawUrl(item.imageThumb) : '') %>"
              data-title="<%= item.title %>"
              data-year="<%= item.year || '' %>"
              data-event="<%= item.event || '' %>"
              data-description="<%= item.description || '' %>"
              <% if (idx < featured.length || idx >= featured.length * 2) { %>aria-hidden="true" tabindex="-1"<% } %>
            >
              <div class="artwork__frame">
                <% if (item.imageThumb) { %>
                  <img src="<%= rawUrl(item.imageThumb) %>" alt="<%= item.title %>" loading="lazy" />
                <% } %>
              </div>
              <div class="artwork__label">
                <span class="artwork__title"><%= item.title %></span><% if (item.year) { %>, <span class="artwork__year"><%= item.year %></span><% } %>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    </section>
  <% } %>

  <% if (home.about) { %>
    <section class="about wrap">
      <div class="about__card reveal">
        <p class="eyebrow">О художнике</p>
        <h2 class="about__heading">Творческий путь</h2>
        <p class="about__text"><%= home.about %></p>
      </div>
    </section>
  <% } %>

  <%- include('partials/modal') %>
  <%- include('partials/footer') %>
  <script src="/js/modal.js"></script>
  <script src="/js/reveal.js"></script>
  <script src="/js/carousel.js"></script>
</body>
</html>
