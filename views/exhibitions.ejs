<!DOCTYPE html>
<html lang="ru">
<head>
  <title>Выставки — <%= siteTitle %></title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="wrap page">
    <p class="eyebrow">Хроника</p>
    <h1 class="page-title">Выставки</h1>

    <% if (items.length === 0) { %>
      <p class="empty-state">Выставки пока не добавлены.</p>
    <% } else { %>
      <ol class="timeline">
        <% items.forEach(function(item, idx) { %>
          <li class="timeline__item reveal" style="transition-delay: <%= Math.min(idx * 70, 420) %>ms">
            <span class="timeline__year"><%= item.year || '' %></span>
            <span class="timeline__dot"></span>
            <div class="timeline__card">
              <h3 class="timeline__title"><%= item.title %></h3>
              <% if (item.place) { %><p class="timeline__place"><%= item.place %></p><% } %>
              <% if (item.description) { %><p class="timeline__desc"><%= item.description %></p><% } %>
            </div>
          </li>
        <% }); %>
      </ol>
    <% } %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
