<header class="site-header">
  <div class="wrap site-header__row">
    <div class="site-header__brand">
      <span class="site-header__eyebrow">Творческое портфолио</span>
      <a href="/" class="site-title"><%= siteTitle %></a>
    </div>
  </div>

  <nav class="site-nav">
    <a href="/" class="<% if (currentPath === '/') { %>is-active<% } %>">Главная</a>
    <a href="/gallery" class="<% if (currentPath && currentPath.startsWith('/gallery')) { %>is-active<% } %>">Галерея</a>
    <a href="/process" class="<% if (currentPath === '/process') { %>is-active<% } %>">Рукоделие</a>
    <a href="/awards" class="<% if (currentPath === '/awards') { %>is-active<% } %>">Награды</a>
    <a href="/exhibitions" class="<% if (currentPath === '/exhibitions') { %>is-active<% } %>">Выставки</a>
  </nav>
</header>
