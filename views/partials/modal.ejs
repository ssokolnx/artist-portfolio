<div class="modal" id="artwork-modal" aria-hidden="true">
  <div class="modal__card" role="dialog" aria-modal="true" aria-label="Просмотр работы">
    <button type="button" class="modal__close" aria-label="Закрыть">✕</button>
    <div class="modal__image-wrap">
      <img class="modal__image" src="" alt="" />
    </div>
    <div class="modal__info">
